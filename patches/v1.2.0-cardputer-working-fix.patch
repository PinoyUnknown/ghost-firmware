+void connectToSelectedWifi()
+{
+    WiFi.mode(WIFI_MODE_STA);
+    WiFi.disconnect(false, false);
+    delay(50);
+    if (wifiPasswordInput.isEmpty()) {
+        WiFi.begin(wifiTargetSsid.c_str());
+    } else {
+        WiFi.begin(wifiTargetSsid.c_str(), wifiPasswordInput.c_str());
+    }
+    connectStatusMessage = "Connecting to " + wifiTargetSsid + "...";
+    const uint32_t startMs = millis();
+    while (WiFi.status() != WL_CONNECTED && millis() - startMs < 7000) {
+        delay(150);
+    }
+    if (WiFi.status() == WL_CONNECTED) {
+        connectStatusMessage = "Connected: " + WiFi.localIP().toString();
+        setStatusBanner("Wi-Fi connected!");
+    } else {
+        connectStatusMessage = "Connect failed (check password/signal)";
+        setStatusBanner("Wi-Fi connection failed");
+    }
+}
+
+void runNetworkConnectivityTest()
+{
+    if (WiFi.status() != WL_CONNECTED) {
+        connectStatusMessage = "Not connected to Wi-Fi";
+        setStatusBanner("Connect to Wi-Fi first");
+        return;
+    }
+    IPAddress resolvedIp;
+    const uint32_t startMs = millis();
+    if (WiFi.hostByName("pool.ntp.org", resolvedIp)) {
+        const uint32_t elapsed = millis() - startMs;
+        connectStatusMessage = "DNS OK: " + resolvedIp.toString() + " (" + String(elapsed) + "ms)";
+        setStatusBanner("Network DNS test passed");
+    } else {
+        connectStatusMessage = "DNS lookup failed (no internet?)";
+        setStatusBanner("DNS lookup failed");
+    }
+}
+
+void scanGroveI2cBus()
+{
+    detectedI2cCount = 0;
+    Wire1.begin(kGroveSdaPin, kGroveSclPin, 100000);
+    for (uint8_t addr = 0x08; addr < 0x78 && detectedI2cCount < detectedI2cAddresses.size(); ++addr) {
+        Wire1.beginTransmission(addr);
+        if (Wire1.endTransmission() == 0) {
+            detectedI2cAddresses[detectedI2cCount++] = addr;
+        }
+    }
+    Wire1.end();
+}
+
+void sendNecPulse(uint32_t markUs, uint32_t spaceUs)
+{
+    const uint32_t cycles = markUs / 26;
+    for (uint32_t i = 0; i < cycles; ++i) {
+        digitalWrite(kCardputerIrPin, HIGH);
+        delayMicroseconds(9);
+        digitalWrite(kCardputerIrPin, LOW);
+        delayMicroseconds(17);
+    }
+    delayMicroseconds(spaceUs);
+}
+
+void transmitIrCommand(const IrCommand &cmd)
+{
+    pinMode(kCardputerIrPin, OUTPUT);
+    digitalWrite(kCardputerIrPin, LOW);
+
+    const uint32_t frame = static_cast<uint32_t>(cmd.address & 0xFFFF) |
+                           (static_cast<uint32_t>(cmd.command) << 16) |
+                           (static_cast<uint32_t>(static_cast<uint8_t>(~cmd.command)) << 24);
+
+    sendNecPulse(9000, 4500);
+    for (uint8_t bit = 0; bit < 32; ++bit) {
+        if ((frame >> bit) & 0x01U) {
+            sendNecPulse(560, 1690);
+        } else {
+            sendNecPulse(560, 560);
+        }
+    }
+    sendNecPulse(560, 2000);
+    digitalWrite(kCardputerIrPin, LOW);
+
+    snprintf(lastIrStatus, sizeof(lastIrStatus), "Sent %s (0x%02X) on G%u", cmd.label, cmd.command,
+             kCardputerIrPin);
+    setStatusBanner("IR pulse sent on GPIO 44");
+}
